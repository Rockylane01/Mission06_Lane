@model Movie

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card mt-4">
                <div class="card-body">
                    <h3 class="card-title mb-3">Add A Movie</h3>

                    <form id="add-movie" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Category Id</label>
                            <input asp-for="CategoryId" name="CategoryId" class="form-control" required />
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Title</label>
                            <input asp-for="Title" name="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label">Release Year</label>
                            <input asp-for="Year" name="Year" class="form-control" type="number" required />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Director" class="form-label">Director</label>
                            <input asp-for="Director" name="Director" class="form-control" required />
                            <span asp-validation-for="Director" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">Rating</label>
                            <select asp-for="Rating" name="Rating" class="form-select" required>
                                <option value="" selected>---</option>
                                <option value="G">G</option>
                                <option value="PG">PG</option>
                                <option value="PG-13">PG-13</option>
                                <option value="R">R</option>
                            </select>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Edited" class="form-label">Edited</label>
                            <select asp-for="Edited" name="Edited" class="form-select">
                                <option value="" selected>---</option>
                                <option value="0">No</option>
                                <option value="1">Yes</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LentTo" class="form-label">Lent To</label>
                            <input asp-for="LentTo" name="LentTo" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CopiedToPlex" class="form-label">Lent To</label>
                            <input asp-for="CopiedToPlex" name="CopiedToPlex" class="form-control" />
                            <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <input asp-for="Notes" name="Notes" class="form-control" maxlength="25" />
                        </div>

                        <div class="d-grid">
                            <input type="submit" value="Add Movie" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
